#!/bin/sh
set -eu

BASE_DEFAULT="/volume1/hermes"
WORKSPACE_PTR_FILE="/var/packages/hermes/var/workspace.path"
WORKSPACE_HOME_PTR_FILE="/var/packages/hermes/var/workspace.home.path"
WORKSPACE_HOME_DEFAULT="$BASE_DEFAULT"
BASE_STATE_DIR="${BASE_DEFAULT}/.hermes"
BASE_CFG="${BASE_STATE_DIR}/hermes.json"
LEGACY_CFG="/var/packages/hermes/var/hermes.json"
LEGACY_WORKSPACE_CFG="${BASE_DEFAULT}/hermes.json"
APP_DIR="/volume1/@appstore/hermes/app/hermes"
APP_PYTHON="/usr/local/bin/python3.12"

if [ ! -d "$APP_DIR" ]; then
  echo "❌ hermes: Hermes SPK not found under $APP_DIR" >&2
  exit 1
fi

ORIGINAL_ARGS="$*"
CLI_CONFIG_PATH=""
if [ "${1:-}" = "--config" ]; then
  if [ $# -lt 2 ]; then
    echo "❌ hermes: --config requires a file path" >&2
    exit 1
  fi
  CLI_CONFIG_PATH="$2"
  shift 2
fi

CONFIG_PATH=""
if [ -n "${CLI_CONFIG_PATH:-}" ]; then
  CONFIG_PATH="$CLI_CONFIG_PATH"
elif [ -n "${HERMES_CONFIG_PATH:-}" ]; then
  CONFIG_PATH="$HERMES_CONFIG_PATH"
elif [ -f "$BASE_CFG" ]; then
  CONFIG_PATH="$BASE_CFG"
elif [ -f "$LEGACY_CFG" ]; then
  CONFIG_PATH="$LEGACY_CFG"
fi

WORKSPACE_DIR="$BASE_DEFAULT"
read_pointer_value() {
  local f="$1"
  [ -f "$f" ] || return 1
  local v
  v="$(cat "$f" 2>/dev/null | tr -d '\r\n')"
  [ -n "$v" ] || return 1
  case "$v" in
    /*) printf '%s' "$v" ;;
    *) return 1 ;;
  esac
}
if [ -n "${HERMES_WORKSPACE_DIR:-}" ] && [ "${HERMES_WORKSPACE_DIR#/*}" != "$HERMES_WORKSPACE_DIR" ]; then
  WORKSPACE_DIR="$HERMES_WORKSPACE_DIR"
else
  if v="$(read_pointer_value "$WORKSPACE_PTR_FILE" 2>/dev/null)"; then
    WORKSPACE_DIR="$v"
  fi
fi
WORKSPACE_FROM_PTR="0"
if [ "${HERMES_RESPECT_ENV_WORKSPACE:-0}" != "1" ] || [ -z "${HERMES_WORKSPACE_DIR:-}" ]; then
  if [ -f "$WORKSPACE_HOME_PTR_FILE" ]; then
    WS_HOME_RAW="$(cat "$WORKSPACE_HOME_PTR_FILE" 2>/dev/null | tr -d '\r' | tr -d '\n')"
    if [ -n "$WS_HOME_RAW" ]; then
      WORKSPACE_DIR="$WS_HOME_RAW"
      WORKSPACE_FROM_PTR="1"
    fi
  fi
  if [ "$WORKSPACE_FROM_PTR" != "1" ] && [ -f "$WORKSPACE_PTR_FILE" ]; then
    PWS="$(cat "$WORKSPACE_PTR_FILE" 2>/dev/null | tr -d '\r' | tr -d '\n')"
    if [ -n "$PWS" ]; then
      case "$PWS" in
        '$HOME'|'/var/packages/hermes/home') PWS="$WORKSPACE_HOME_DEFAULT" ;;
        '$HOME'/*) PWS="$WORKSPACE_HOME_DEFAULT/${PWS#\$HOME/}" ;;
        '/var/packages/hermes/home'/*) PWS="$WORKSPACE_HOME_DEFAULT/${PWS#/var/packages/hermes/home/}" ;;
        */.hermes) PWS="${PWS%/.hermes}" ;;
      esac
      WORKSPACE_DIR="$PWS"
      WORKSPACE_FROM_PTR="1"
    fi
  fi
fi
if [ -n "$CONFIG_PATH" ]; then
  if [ -z "${HERMES_WORKSPACE_DIR:-}" ] && [ "$WORKSPACE_FROM_PTR" != "1" ]; then
    W=$(python3 - "$CONFIG_PATH" <<'PY'
import json,sys
p=sys.argv[1]
try:
    c=json.load(open(p,'r',encoding='utf-8'))
    w=((c.get('agents') or {}).get('defaults') or {}).get('workspace')
    print((w or '').strip())
except Exception:
    print('')
PY
)
    if [ -n "$W" ]; then
      case "$W" in
        */.hermes) W="${W%/.hermes}" ;;
      esac
      WORKSPACE_DIR="$W"
      if [ "$CONFIG_PATH" = "$BASE_CFG" ]; then
        case "$WORKSPACE_DIR" in
          */.hermes) CONFIG_PATH="$WORKSPACE_DIR/hermes.json" ;;
          *) CONFIG_PATH="$WORKSPACE_DIR/.hermes/hermes.json" ;;
        esac
      fi
    fi
  fi
fi

case "$WORKSPACE_DIR" in
  */.hermes) WORKSPACE_DIR="${WORKSPACE_DIR%/.hermes}" ;;
esac
case "$WORKSPACE_DIR" in
  */.hermes) WORKDIR_DEFAULT="$WORKSPACE_DIR" ;;
  *) WORKDIR_DEFAULT="$WORKSPACE_DIR/.hermes" ;;
esac
WORKDIR="${HERMES_STATE_DIR:-$WORKDIR_DEFAULT}"
if [ "$WORKSPACE_FROM_PTR" = "1" ] && [ -z "${CLI_CONFIG_PATH:-}" ] && [ -z "${HERMES_CONFIG_PATH:-}" ]; then
  CONFIG_PATH="$WORKDIR/hermes.json"
elif [ -z "${CONFIG_PATH:-}" ] || [ "$CONFIG_PATH" = "$BASE_CFG" ]; then
  CONFIG_PATH="$WORKDIR/hermes.json"
fi
HOME="$WORKDIR"
HERMES_HOME="$WORKDIR"

mkdir -p "$WORKDIR"
chmod 700 "$WORKDIR" 2>/dev/null || true
mkdir -p "$(dirname "$WORKSPACE_PTR_FILE")" 2>/dev/null || true
if [ ! -f "$WORKSPACE_PTR_FILE" ]; then
  { printf '%s' "$WORKSPACE_DIR" > "$WORKSPACE_PTR_FILE"; } 2>/dev/null || true
fi
if [ ! -f "$WORKSPACE_HOME_PTR_FILE" ]; then
  { printf '%s' "$WORKSPACE_DIR" > "$WORKSPACE_HOME_PTR_FILE"; } 2>/dev/null || true
fi
chmod 666 "$WORKSPACE_PTR_FILE" "$WORKSPACE_HOME_PTR_FILE" 2>/dev/null || true

HERMES_CONFIG_PATH="$CONFIG_PATH"
HERMES_STATE_DIR="$WORKDIR"
HERMES_WORKSPACE_DIR="$WORKSPACE_DIR"

resolve_service_user() {
  local preferred="sc-hermes"
  if id "$preferred" >/dev/null 2>&1; then
    printf '%s' "$preferred"
    return 0
  fi
  local p
  for p in /var/packages/hermes/conf/privilege /var/packages/hermes/conf/privilege; do
    [ -f "$p" ] || continue
    local u
    u="$(python3 - "$p" <<'PY'
import json,sys
p=sys.argv[1]
try:
  v=(json.load(open(p,'r',encoding='utf-8')) or {}).get('username') or ''
  print(v.strip())
except Exception:
  print('')
PY
)"
    if [ -n "$u" ] && id "$u" >/dev/null 2>&1; then
      printf '%s' "$u"
      return 0
    fi
  done
  printf '%s' "$preferred"
}

HERMES_SERVICE_USER="$(resolve_service_user)"
USER="$HERMES_SERVICE_USER"
LOGNAME="$HERMES_SERVICE_USER"
HOME_DEFAULT="$WORKSPACE_DIR/.hermes"
HOME="${HERMES_HOME:-$HOME_DEFAULT}"
mkdir -p "$HERMES_STATE_DIR/agents/main/sessions" "$HOME/agents/main/sessions" 2>/dev/null || true
chmod 700 "$HERMES_STATE_DIR" "$HOME" 2>/dev/null || true
NPM_CONFIG_CACHE="$HOME/.npm"
XDG_CACHE_HOME="$HOME/.cache"
XDG_CONFIG_HOME="$HOME/.config"
XDG_DATA_HOME="$HOME/.local/share"
JITI_FS_CACHE="$HERMES_STATE_DIR/.cache/jiti"
TMPDIR="$HERMES_STATE_DIR/.tmp"
mkdir -p "$JITI_FS_CACHE" "$TMPDIR" 2>/dev/null || true

HERMES_BUNDLED_PLUGIN_DIR_ALLOWLIST="$(
  python3 - "$HERMES_CONFIG_PATH" <<'PY' 2>/dev/null || true
import json, sys
p = sys.argv[1]
try:
    c = json.load(open(p, 'r', encoding='utf-8'))
except Exception:
    raise SystemExit
plugins = c.get('plugins') if isinstance(c, dict) else {}
if not isinstance(plugins, dict) or plugins.get('bundledDiscovery') != 'allowlist':
    raise SystemExit
ids = []
for value in plugins.get('allow') or []:
    if isinstance(value, str) and value.strip():
        ids.append(value.strip())
entries = plugins.get('entries') or {}
if isinstance(entries, dict):
    for key in entries.keys():
        if isinstance(key, str) and key.strip():
            ids.append(key.strip())
seen = set()
out = []
for item in ids:
    if item not in seen:
        seen.add(item)
        out.append(item)
for item in ('browser', 'feishu', 'qqbot', 'dingtalk', 'wecom', 'hermes-weixin', 'active-memory', 'memory-core', 'memory-wiki'):
    if item not in seen:
        seen.add(item)
        out.append(item)
print(','.join(out))
PY
)"
if [ -n "$HERMES_BUNDLED_PLUGIN_DIR_ALLOWLIST" ]; then
  export HERMES_BUNDLED_PLUGIN_DIR_ALLOWLIST
fi

# Add bundled Node.js to PATH for TUI (Chat tab)
NODE_BIN="$WORKDIR/node/bin"
if [ -d "$NODE_BIN" ]; then
  PATH="$NODE_BIN:$PATH"
fi

export HERMES_HOME HERMES_CONFIG_PATH HERMES_STATE_DIR HERMES_WORKSPACE_DIR HOME HERMES_SERVICE_USER USER LOGNAME NPM_CONFIG_CACHE XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME JITI_FS_CACHE TMPDIR PATH

show_help() {
  cat <<'HELP_EOF'
hermes - Hermes Agent Synology SPK wrapper

What it does:
- Auto-locates SPK user folder (default: /volume1/hermes)
- Runtime state/config default to /volume1/hermes/.hermes
- Respects explicit path overrides (--config /path or HERMES_CONFIG_PATH)
- Exports HERMES_CONFIG_PATH / HERMES_STATE_DIR / HOME
- Forwards args to Hermes Agent CLI (with PYTHONPATH)

Usage:
  hermes [--config /path/to/hermes.json] <command> [args...]

Common examples:
  hermes gateway status
  hermes gateway restart
  hermes config get
  hermes plugins install <name>
  hermes models list

Helper commands:
  hermes env      # print resolved paths
  hermes token    # print gateway auth token from current config

Note:
- The initial token is generated randomly during install and stored in hermes.json.
HELP_EOF
}

if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

case "$1" in
  --help|-h|help)
    show_help
    exit 0
    ;;
  env)
    echo "HERMES_CONFIG_PATH=$HERMES_CONFIG_PATH"
    echo "HERMES_STATE_DIR=$HERMES_STATE_DIR"
    echo "HOME=$HOME"
    exit 0
    ;;
  token)
    python3 - "$HERMES_CONFIG_PATH" <<'PY'
import json,sys
p=sys.argv[1]
try:
    c=json.load(open(p,'r',encoding='utf-8'))
    t=((c.get('gateway') or {}).get('auth') or {}).get('token')
    print(t if t else '')
except Exception:
    print('')
PY
    exit 0
    ;;
  doctor)
    shift
    if [ $# -eq 0 ]; then
      exec env PYTHONPATH="$APP_DIR:/volume1/@appstore/hermes/app" "$APP_PYTHON" -m hermes_cli.main doctor
    fi
    exec env PYTHONPATH="$APP_DIR:/volume1/@appstore/hermes/app" "$APP_PYTHON" -m hermes_cli.main doctor "$@"
    ;;
esac

# Default: forward to Hermes CLI via python -m hermes_cli
exec env PYTHONPATH="$APP_DIR:/volume1/@appstore/hermes/app" "$APP_PYTHON" -m hermes_cli.main "$@"
