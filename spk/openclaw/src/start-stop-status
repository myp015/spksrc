#!/bin/sh
# OpenClaw (container mode) — start/stop/status.
#
# The Docker container is managed by DSM "Container Manager" through the
# package's docker-project resource; CM creates, starts and stops the
# container with the package lifecycle. This script therefore only provides
# a status health-check (like the Baidu Netdisk package) and is a no-op for
# start/stop — avoiding any need for the package scripts to touch docker.
#
# Usage: start-stop-status {start|stop|status}
set -u

DNAME="OpenClaw"
CONTAINER_NAME="openclaw"

SYNOPKG_PKGVAR="${SYNOPKG_PKGVAR:-/var/packages/${SYNOPKG_PKGNAME:-openclaw}/var}"
GATEWAY_PORT="58789"
if [ -r "${SYNOPKG_PKGVAR}/container.env" ]; then
    . "${SYNOPKG_PKGVAR}/container.env"
    GATEWAY_PORT="${CONTAINER_GATEWAY_PORT:-58789}"
fi

# Host-side bundled terminal (ttyd) lifecycle helper.
TERMINAL_SCRIPT="/var/packages/${SYNOPKG_PKGNAME:-openclaw}/target/scripts/terminal.sh"

case "$1" in
    start)
        # Container Manager starts the container; we also bring up the
        # host-side web terminal (ttyd).
        if [ -x "${TERMINAL_SCRIPT}" ]; then
            "${TERMINAL_SCRIPT}" start >/dev/null 2>&1 || true
        fi
        exit 0
        ;;
    stop)
        # Container Manager stops the container; stop the web terminal too.
        if [ -x "${TERMINAL_SCRIPT}" ]; then
            "${TERMINAL_SCRIPT}" stop >/dev/null 2>&1 || true
        fi
        exit 0
        ;;
    status)
        # Health-check: report running when the gateway port is up.
        if command -v curl >/dev/null 2>&1 && [ -n "${GATEWAY_PORT}" ]; then
            if curl -s -m 3 "http://127.0.0.1:${GATEWAY_PORT}/" >/dev/null 2>&1; then
                echo "${DNAME} is running"
                exit 0
            fi
        fi
        echo "${DNAME} is not running"
        exit 1
        ;;
    log)
        echo ""
        ;;
    *)
        echo "Usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
